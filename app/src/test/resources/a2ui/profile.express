
$/selected=""
root=Panel(border=true,radius="lg",child=Column(gap="md",children=[header,Divider(),Text(text="一个长期陪伴你、了解你、主动帮助你的 AI 助理。"),features,details]))
header=Row(weights=[0,1],gap="md",align="center",children=[logo,Column(gap="xs",children=[Text(text="Orbit",variant="h1"),RichText(runs=[{text:"Your companion, your choice.",tone:"muted"}])])])
logo=Panel(padding="sm",radius="lg",background="inset",child=Vector(label="Orbit 环形标志",width=40,height=40,shapes=[{type:"circle",cx:20,cy:20,r:13,stroke:3},{type:"circle",cx:10,cy:30,r:4,filled:true}]))
features=Grid(minItemWidth=140,children=[role,memory,companion,tasks])
details=Column(children=[Conditional(visible=equals(a=$/selected,b="role"),children=[Panel(background="inset",child=Column(children=[Heading(text="自由选择角色"),Text(text="选择适合自己的角色与交流方式。")]))]),Conditional(visible=equals(a=$/selected,b="memory"),children=[Panel(background="inset",child=Column(children=[Heading(text="长期记忆"),Text(text="在本地展开这一项的说明，再次点击同一项即可收起。")]))]),Conditional(visible=equals(a=$/selected,b="companion"),children=[Panel(background="inset",child=Column(children=[Heading(text="主动陪伴"),Text(text="这里是交互演示，不会启动后台任务或发送模型请求。")]))]),Conditional(visible=equals(a=$/selected,b="tasks"),children=[Panel(background="inset",child=Column(children=[Heading(text="自主任务"),Text(text="需要真实执行时，再设置明确的操作入口与确认流程。")]))])])
role=Pressable(label="自由选择角色",selected=equals(a=$/selected,b="role"),action=Event(name="local_action",context={op:"set",path:"/selected",value:if(condition=equals(a=$/selected,b="role"),then="",else="role")}),child=Panel(background="inset",child=Column(gap="sm",children=[Icon(name="person"),Heading(text="自由选择角色"),Text(text="任何角色卡都可以成为伴侣")])))
memory=Pressable(label="长期记忆",selected=equals(a=$/selected,b="memory"),action=Event(name="local_action",context={op:"set",path:"/selected",value:if(condition=equals(a=$/selected,b="memory"),then="",else="memory")}),child=Panel(background="inset",child=Column(gap="sm",children=[Icon(name="storage"),Heading(text="长期记忆"),Text(text="持续理解经历与偏好")])))
companion=Pressable(label="主动陪伴",selected=equals(a=$/selected,b="companion"),action=Event(name="local_action",context={op:"set",path:"/selected",value:if(condition=equals(a=$/selected,b="companion"),then="",else="companion")}),child=Panel(background="inset",child=Column(gap="sm",children=[Icon(name="chat"),Heading(text="主动陪伴"),Text(text="让交流自然地延续")])))
