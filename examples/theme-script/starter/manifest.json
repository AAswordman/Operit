              "start": 2,
              "top": 2,
              "end": 2,
              "bottom": 2
            },
            "messageWidth": 0.9
          }
        },
        "typography": {
          "family": "sans-serif",
          "scale": 1,
          "lineHeight": 1.05,
          "letterSpacing": 0,
          "color": "#E0EBDD"
        }
      },
      "light": {
        "typography": {
          "family": "sans-serif",
          "scale": 1,
          "lineHeight": 1.05,
          "letterSpacing": 0,
          "color": "#26332B"
        }
      }
    }
