        "shape": {
          "type": "rounded",
          "radius": 20
        },
        "padding": {
          "start": 4,
          "top": 2,
          "end": 4,
          "bottom": 2
        },
        "strokeColor": "#80386A4C",
        "strokeWidth": 1,
        "minHeight": 48,
        "states": {
          "focused": {
            "strokeWidth": 2
          }
        }
      },
      "userMessage": {
        "shape": {
          "type": "rounded",
          "radius": 16
        },
        "fillColor": "#BAF0C9",
