          "start": 2,
          "top": 2,
          "end": 2,
          "bottom": 2
        },
        "messageWidth": 0.9
      },
      "userAvatar": {
        "size": 36,
        "shape": {
          "type": "rounded",
          "radius": 12
        }
      },
      "assistantAvatar": {
        "size": 36,
        "shape": {
          "type": "rounded",
          "radius": 12
        }
      },
      "button": {
        "shape": {
          "type": "rounded",
          "radius": 12
        },
        "states": {
          "pressed": {
            "opacity": 0.85
          },
          "disabled": {
            "opacity": 0.45
          }
        }
      },
      "navigationItem": {
        "shape": {
          "type": "rounded",
          "radius": 12
        },
        "states": {
          "selected": {
            "strokeColor": "#80386A4C",
            "strokeWidth": 1
          }
        }
      }
