{
  "apiVersion": 1,
  "entry": "assets/main.js",
  "assets": {},
  "appearance": {
    "apiVersion": 1,
    "palette": {
      "light": {
        "primary": "#386A4C",
        "onPrimary": "#FFFFFF",
        "primaryContainer": "#BAF0C9",
        "onPrimaryContainer": "#00210F",
        "background": "#F6FBF4",
        "onBackground": "#181D19",
        "surface": "#F6FBF4",
        "onSurface": "#181D19",
        "outline": "#717972"
      },
      "dark": {
        "primary": "#A0D5AE",
        "onPrimary": "#07381D",
        "primaryContainer": "#205134",
        "onPrimaryContainer": "#BAF0C9",
        "background": "#101511",
        "onBackground": "#DFE4DD",
        "surface": "#101511",
        "onSurface": "#DFE4DD",
        "outline": "#8B938C"
      }
    },
    "typography": {
      "family": "sans-serif",
      "scale": 1,
      "lineHeight": 1.05,
